<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nécessaire pour piloter Apple Music et Spotify par AppleScript. Sans
	     cette autorisation, le runtime durci bloque tout événement Apple sortant
	     dès qu'on signe pour de bon — la construction en ad-hoc, elle, désactive
	     le runtime durci et masque le problème jusqu'au jour de la distribution. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Le miroir, qui ne démarre que sur un clic. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- La transcription vocale, qui ne démarre que sur un clic. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Le prochain rendez-vous affiché dans le tableau de bord. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- La météo du lieu. Une ville saisie à la main s'en passe. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
